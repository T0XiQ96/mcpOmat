{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mcpomat.dev/schema/manifest.json",
  "title": "Pitter-o-mat SD Manifest",
  "type": "object",
  "required": [
    "manifestVersion",
    "generatedAt",
    "masterFirmware",
    "content",
    "bundleHash"
  ],
  "properties": {
    "manifestVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "masterFirmware": {
      "type": "object",
      "required": ["version", "hash"],
      "properties": {
        "version": { "type": "string" },
        "hash": { "$ref": "#/definitions/hash" }
      },
      "additionalProperties": false
    },
    "notes": { "type": "string" },
    "content": {
      "type": "array",
      "items": { "$ref": "#/definitions/category" },
      "minItems": 1
    },
    "bundleHash": { "$ref": "#/definitions/hash" }
  },
  "additionalProperties": false,
  "definitions": {
    "hash": {
      "type": "string",
      "pattern": "^(sha256:)?[0-9a-fA-F]{64}$"
    },
    "categoryType": {
      "type": "string",
      "enum": ["game", "options", "theme", "profile", "music", "logo"]
    },
    "category": {
      "type": "object",
      "required": ["type", "entries"],
      "properties": {
        "type": { "$ref": "#/definitions/categoryType" },
        "entries": {
          "type": "array",
          "items": { "$ref": "#/definitions/entry" }
        }
      },
      "additionalProperties": false
    },
    "entry": {
      "type": "object",
      "required": ["id", "version", "file", "hash"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9\\-]{1,63}$"
        },
        "version": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "file": {
          "type": "string",
          "pattern": "^([a-z0-9\\-_/]+\\.)[a-z0-9]{1,16}$"
        },
        "hash": { "$ref": "#/definitions/hash" },
        "players": {
          "type": "object",
          "required": ["min", "max"],
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 1,
              "maximum": 6
            },
            "max": {
              "type": "integer",
              "minimum": 1,
              "maximum": 6
            },
            "recommended": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 6
              },
              "uniqueItems": true
            }
          },
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "min": { "const": 1 }
                }
              },
              "then": {
                "properties": {
                  "max": { "minimum": 1 }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "min": { "const": 2 }
                }
              },
              "then": {
                "properties": {
                  "max": { "minimum": 2 }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "min": { "const": 3 }
                }
              },
              "then": {
                "properties": {
                  "max": { "minimum": 3 }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "min": { "const": 4 }
                }
              },
              "then": {
                "properties": {
                  "max": { "minimum": 4 }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "min": { "const": 5 }
                }
              },
              "then": {
                "properties": {
                  "max": { "minimum": 5 }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "min": { "const": 6 }
                }
              },
              "then": {
                "properties": {
                  "max": { "minimum": 6 }
                }
              }
            }
          ]
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["user", "admin", "system"]
          },
          "uniqueItems": true
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9\\-]{1,63}$"
          },
          "uniqueItems": true
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    }
  }
}
