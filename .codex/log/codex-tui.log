+#include <Arduino.h>
+
+/**
+ * Display Sync Bus Test – ESP32 touch node
+ * --------------------------------------------------
+ * Same sketch runs on up to six touch displays. Define
+ * DISPLAY_ID (1..6). Node 1 acts as coordinator and pings
+ * every other node; nodes 2..6 answer with echo frames.
+ *
+ * Verdrahtung:
+ *   RS485 A/B/GND der Displays sternförmig verbinden.
+ *   Versorgung jeweils per USB (gemeinsame Masse).
+ *
+ * Konfiguration:
+ *   #define DISPLAY_ID 1
+ *   #define TOTAL_NODES 6
+ */
+
+#ifndef DISPLAY_ID
+#define DISPLAY_ID 1
+#endif
+
+#ifndef TOTAL_NODES
+#define TOTAL_NODES 6
+#endif
+
+static_assert(DISPLAY_ID >= 1 && DISPLAY_ID <= TOTAL_NODES,
+              "DISPLAY_ID must be within 1..TOTAL_NODES");
+
+namespace {
+
+constexpr uint8_t RS485_TX_PIN = 44;
+constexpr uint8_t RS485_RX_PIN = 43;
+constexpr uint8_t RS485_DE_PIN = 21;
+constexpr uint32_t RS485_BAUD = 250000;
+constexpr uint8_t RS485_SYNC = 0xAA;
+constexpr size_t RS485_MAX_PAYLOAD = 64;
+
+constexpr uint8_t PING_TYPE = 0x30;
+constexpr uint8_t ACK_TYPE = 0x31;
+
+constexpr uint16_t PING_INTERVAL_MS = 2000;
+
+HardwareSerial &rs485 = Serial1;
+
+struct FrameBuffer {
+  enum class State : uint8_t { WaitSync, MsgType, Length, Payload, Crc };
+  State state = State::WaitSync;
+  uint8_t type = 0;
+  uint8_t length = 0;
+  uint8_t index = 0;
+  uint8_t payload[RS485_MAX_PAYLOAD]{};
+} g_rx;
+
+uint8_t currentSeq = 0;
+bool awaiting[TOTAL_NODES + 1] = {false};
+unsigned long lastPingMs = 0;
+
+uint8_t crc8Update(uint8_t crc, uint8_t byte) {
+  crc ^= byte;
+  for (uint8_t i = 0; i < 8; ++i) {
+    crc = (crc & 0x01U) ? (crc >> 1) ^ 0x8CU : crc >> 1;
+  }
+  return crc;
+}
+
+uint8_t crc8Update(uint8_t crc, const uint8_t *data, size_t length) {
+  for (size_t i = 0; i < length; ++i) {
+    crc = crc8Update(crc, data[i]);
+  }
+  return crc;
+}
+
+void setTransmit(bool enable) {
+  digitalWrite(RS485_DE_PIN, enable ? HIGH : LOW);
+  if (!enable) {
+    rs485.flush();
+  }
+}
+
+void sendFrame(uint8_t type, const uint8_t *payload, uint8_t length) {
+  if (length > RS485_MAX_PAYLOAD) {
+    Serial.printf("[ID %u] payload too large (%u bytes)\n", DISPLAY_ID, length);
+    return;
+  }
+  uint8_t crc = 0;
+  crc = crc8Update(crc, type);
+  crc = crc8Update(crc, length);
+  if (length > 0 && payload != nullptr) {
+    crc = crc8Update(crc, payload, length);
+  }
+
+  uint8_t header[3] = {RS485_SYNC, type, length};
+  setTransmit(true);
+  rs485.write(header, sizeof(header));
+  if (length > 0 && payload != nullptr) {
+    rs485.write(payload, length);
+  }
+  rs485.write(crc);
+  rs485.flush();
+  setTransmit(false);
+}
+
+void resetReceiver(bool synced) {
+  g_rx.state = synced ? FrameBuffer::State::MsgType : FrameBuffer::State::WaitSync;
+  g_rx.type = 0;
+  g_rx.length = 0;
+  g_rx.index = 0;
+}
+
+bool pollFrame(uint8_t &type, uint8_t &length, uint8_t *payload) {
+  while (rs485.available() > 0) {
+    uint8_t byte = static_cast<uint8_t>(rs485.read());
+    switch (g_rx.state) {
+    case FrameBuffer::State::WaitSync:
+      if (byte == RS485_SYNC) {
+        resetReceiver(true);
+      }
+      break;
+    case FrameBuffer::State::MsgType:
+      g_rx.type = byte;
+      g_rx.state = FrameBuffer::State::Length;
+      break;
+    case FrameBuffer::State::Length:
+      g_rx.length = byte;
+      if (g_rx.length > RS485_MAX_PAYLOAD) {
+        Serial.printf("[ID %u] drop frame len=%u\n", DISPLAY_ID, g_rx.length);
+        resetReceiver(false);
+      } else if (g_rx.length == 0) {
+        g_rx.state = FrameBuffer::State::Crc;
+      } else {
+        g_rx.index = 0;
+        g_rx.state = FrameBuffer::State::Payload;
+      }
+      break;
+    case FrameBuffer::State::Payload:
+      g_rx.payload[g_rx.index++] = byte;
+      if (g_rx.index >= g_rx.length) {
+        g_rx.state = FrameBuffer::State::Crc;
+      }
+      break;
+    case FrameBuffer::State::Crc: {
+      uint8_t crc = 0;
+      crc = crc8Update(crc, g_rx.type);
+      crc = crc8Update(crc, g_rx.length);
+      crc = crc8Update(crc, g_rx.payload, g_rx.length);
+      bool crcOk = (crc == byte);
+      bool treatAsSync = (byte == RS485_SYNC);
+      if (crcOk) {
+        type = g_rx.type;
+        length = g_rx.length;
+        if (length > 0 && payload != nullptr) {
+          memcpy(payload, g_rx.payload, length);
+        }
+        resetReceiver(false);
+        return true;
+      }
+      Serial.printf("[ID %u] crc mismatch exp=0x%02X got=0x%02X\n", DISPLAY_ID, crc, byte);
+      resetReceiver(treatAsSync);
+      break;
+    }
+    }
+  }
+  return false;
+}
+
+void sendPing(uint8_t targetId) {
+  uint8_t payload[3] = {static_cast<uint8_t>(DISPLAY_ID), targetId, currentSeq};
+  sendFrame(PING_TYPE, payload, sizeof(payload));
+  Serial.printf("[ID %u] ping -> %u seq %u\n", DISPLAY_ID, targetId, currentSeq);
+  if (targetId < awaiting[0] /*unused*/ ) {
+    // no-op: placeholder to avoid static analyser warning
+  }
+}
+
+void sendAck(uint8_t targetId, uint8_t seq) {
+  uint8_t payload[3] = {static_cast<uint8_t>(DISPLAY_ID), targetId, seq};
+  sendFrame(ACK_TYPE, payload, sizeof(payload));
+  Serial.printf("[ID %u] ack -> %u seq %u\n", DISPLAY_ID, targetId, seq);
+}
+
+bool isCoordinator() {
+  return DISPLAY_ID == 1;
+}
+
+void coordinatorLoop() {
+  if (millis() - lastPingMs >= PING_INTERVAL_MS) {
+    lastPingMs = millis();
+    currentSeq = static_cast<uint8_t>(currentSeq + 1);
+    if (currentSeq == 0) {
+      currentSeq = 1;
+    }
+    for (uint8_t id = 2; id <= TOTAL_NODES; ++id) {
+      awaiting[id] = true;
+      sendPing(id);
+      delay(50);
+    }
+  }
+}
+
+void handleFrame(uint8_t type, uint8_t length, const uint8_t *payload) {
+  if (type == PING_TYPE && length >= 3) {
+    uint8_t origin = payload[0];
+    uint8_t target = payload[1];
+    uint8_t seq = payload[2];
+    if (target == DISPLAY_ID) {
+      Serial.printf("[ID %u] ping from %u seq %u\n", DISPLAY_ID, origin, seq);
+      sendAck(origin, seq);
+    }
+  } else if (type == ACK_TYPE && length >= 3) {
+    uint8_t origin = payload[0];
+    uint8_t target = payload[1];
+    uint8_t seq = payload[2];
+    if (target == DISPLAY_ID) {
+      Serial.printf("[ID %u] ack <- %u seq %u\n", DISPLAY_ID, origin, seq);
+      if (isCoordinator() && origin <= TOTAL_NODES && seq == currentSeq) {
+        awaiting[origin] = false;
+      }
+    }
+  }
+}
+
+} // namespace
+
+void setup() {
+  Serial.begin(115200);
+  unsigned long startWait = millis();
+  while (!Serial && (millis() - startWait) < 3000) {
+    delay(10);
+  }
+  Serial.println();
+  Serial.printf("== Display Sync Node (ID=%u) ==\n", DISPLAY_ID);
+
+  pinMode(RS485_DE_PIN, OUTPUT);
+  digitalWrite(RS485_DE_PIN, LOW);
+  rs485.begin(RS485_BAUD, SERIAL_8N1, RS485_RX_PIN, RS485_TX_PIN);
+  delay(50);
+
+  if (isCoordinator()) {
+    memset(awaiting, 0, sizeof(awaiting));
+    lastPingMs = millis();
+  }
+}
+
+void loop() {
+  uint8_t type = 0;
+  uint8_t length = 0;
+  uint8_t payload[RS485_MAX_PAYLOAD];
+
+  if (pollFrame(type, length, payload)) {
+    handleFrame(type, length, payload);
+  }
+
+  if (isCoordinator()) {
+    coordinatorLoop();
+  }
+
+  delay(5);
+}
