+{
+  "id": "sample-options",
+  "version": "0.1.0",
+  "title": "Demo-Optionen",
+  "description": "Steuert Joker-Standardwerte und Countdown f\u00fcr das Demo-Spiel.",
+  "scope": "user",
+  "appliesTo": ["sample-rotation"],
+  "requiresRestart": false,
+  "sync": "onStart",
+  "fields": [
+    {
+      "key": "jokerEnabled",
+      "type": "boolean",
+      "label": "Joker aktivieren",
+      "description": "Aktiviert die Joker-Segmente in der Demo.",
+      "default": true
+    },
+    {
+      "key": "countdownSeconds",
+      "type": "integer",
+      "label": "Countdown (s)",
+      "description": "Vorbereitungszeit bis zum Start.",
+      "default": 5,
+      "min": 3,
+      "max": 15
+    },
+    {
+      "key": "colorTheme",
+      "type": "enum",
+      "label": "Farbthema",
+      "description": "LED-Farbmodus f\u00fcr das Demo-Spiel.",
+      "default": "classic",
+      "choices": [
+        { "value": "classic", "label": "Classic Blau" },
+        { "value": "neon", "label": "Neon Gelb" }
+      ]
+    }
+  ],
+  "effects": [
+    {
+      "target": "session",
+      "action": "configureJoker",
+      "params": { "optionKey": "jokerEnabled" },
+      "apply": "onStart"
+    },
+    {
+      "target": "session",
+      "action": "setCountdown",
+      "params": { "optionKey": "countdownSeconds" },
+      "apply": "onStart"
+    },
+    {
+      "target": "led",
+      "action": "setTheme",
+      "params": { "optionKey": "colorTheme" }
+    }
+  ],
+  "metadata": {
+    "demo": true
+  }
+}
