{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mcpomat.dev/schema/display-map.json",
  "title": "Pitter-o-mat Display Map",
  "type": "object",
  "properties": {
    "players": {
      "type": "object",
      "patternProperties": {
        "^[2-6]$": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": {
            "type": "object",
            "required": ["slot_id", "display_id"],
            "properties": {
              "slot_id": {
                "type": "integer",
                "minimum": 1,
                "maximum": 6
              },
              "display_id": {
                "type": "integer",
                "minimum": 1,
                "maximum": 12
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["players"],
  "additionalProperties": false
}
